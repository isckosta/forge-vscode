{
  "name": "forge-vscode",
  "displayName": "Forge for VS Code",
  "description": "Visual Studio Code integration for the Forge Protocol.",
  "version": "0.0.1",
  "publisher": "forge-protocol",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:forge.explorer",
    "workspaceContains:.forge/forge.yml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "forge.showVersion",
        "title": "Forge: Show Version"
      },
      {
        "command": "forge.review.setMode",
        "title": "Forge: Set Review Mode…"
      },
      {
        "command": "forge.review.setDefaultMode",
        "title": "Forge: Set Default Review Mode…"
      },
      {
        "command": "forge.review.stop",
        "title": "Forge: Stop Review"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "forge.review.setMode",
          "when": "view == forge.explorer && viewItem == change",
          "group": "forge-review@1"
        },
        {
          "command": "forge.review.stop",
          "when": "view == forge.explorer && viewItem == change",
          "group": "forge-review@2"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "forge",
          "title": "Forge",
          "icon": "$(tools)"
        }
      ]
    },
    "views": {
      "forge": [
        {
          "id": "forge.explorer",
          "name": "Explorer"
        }
      ]
    },
    "configuration": {
      "title": "Forge",
      "properties": {
        "forge.review.defaultMode": {
          "type": "string",
          "enum": ["recommended", "fast", "thorough"],
          "enumDescriptions": [
            "Forge determines the rigor appropriate to the Change.",
            "Prioritizes speed and the findings that matter most.",
            "Deeper, adversarial analysis for changes that need stronger assurance."
          ],
          "default": "recommended",
          "scope": "resource",
          "description": "Default Review mode suggested when setting a Change's Review mode. This is an extension-side preference only — it never silently reduces assurance required by Flow or the Engineering Contract."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "pretest": "npm run compile",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/mocha": "^10.0.7",
    "@types/node": "^20.14.15",
    "@types/vscode": "^1.90.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^9.9.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.0"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
